# Скопируйте в .env и заполните. Реальные ключи в репозиторий НЕ коммитить.

# БД: локально можно SQLite, в docker-compose — PostgreSQL
DATABASE_URL=sqlite:///./civicflow.db
# DATABASE_URL=postgresql+psycopg://civicflow:civicflow@localhost:5432/civicflow

# rule_based — встроенная заглушка без LLM; llm — модули участников 1 и 2
AGENT_MODE=rule_based
EXTRACTOR=rule_based
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_S=60

CONFIDENCE_THRESHOLD=0.6
DUPLICATE_THRESHOLD=0.5
DUPLICATE_WINDOW_DAYS=30
LOG_LEVEL=INFO

# Для LLM (Участник 1)
# GIGACHAT_CREDENTIALS=
# GIGACHAT_MODEL=GigaChat
